# Copy to vidbot.env and fill in. Sourced by vidbotctl, so a bare
# `vidbotctl start` after a container restart watches the same channels as
# before -- without it the channel list lives only in whichever shell happened
# to launch the daemon, and the bot quietly comes back watching less than it
# was, which looks identical to the bot simply not working.
#
# vidbot.env itself is gitignored. The real IDs are deployment configuration
# and the DISCORD_TOKEN line below is a place a live token can end up.

# Channels vidbot watches. Space-separated ids.
VIDBOT_CHANNELS="000000000000000000 111111111111111111"

# Seconds between polls. Since the gateway landed this is the FALLBACK rate,
# used whenever the websocket is not carrying events -- which is what makes a
# gateway outage cost latency and nothing else.
VIDBOT_INTERVAL=6

# How often the poll runs as a safety net while the gateway IS healthy.
VIDBOT_RECONCILE=300

# 10 MiB, the ceiling on an unboosted server. Raise to 52428800 at boost tier 2.
VIDBOT_MAX_BYTES=10485760

# Set to any non-empty value to skip the websocket entirely and poll, as the
# daemon did before the gateway existed.
#VIDBOT_NO_GATEWAY=1

# Post as a SEPARATE bot account. Uncomment with a second application's token.
#DISCORD_TOKEN="<second bot application token>"

# Egress proxy for the agent container: the only thing on the agent's network
# with a route out, so the domain policy is enforced here. Filters on the
# CONNECT target; no TLS interception, no CA key.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends squid \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/log/squid /var/spool/squid \
    && chown -R proxy:proxy /var/log/squid /var/spool/squid
COPY squid.conf /etc/squid/squid.conf
EXPOSE 3128
# -N foreground, -d1 log to stdout so `docker logs` shows denials.
CMD ["squid", "-N", "-d1", "-f", "/etc/squid/squid.conf"]

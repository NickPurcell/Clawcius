# Copy to .env and fill in. Never commit the real .env.
#
# Secrets and deployment identity only. Everything describing how the agent
# behaves lives in agent-config.yaml, which is safe to commit.

# ── Discord ───────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
# Also enable: Bot → Privileged Gateway Intents → MESSAGE CONTENT INTENT
# One identity serves both halves: the waker uses the gateway, the agent's
# discord CLI uses REST.
DISCORD_TOKEN=

# The single server the bot operates in. Right-click the server → Copy Server
# ID (requires User Settings → Advanced → Developer Mode).
DISCORD_GUILD_ID=

# ── Anthropic ─────────────────────────────────────────────────────────────
# OPTIONAL — and usually omitted.
#
# The agent inherits this process's environment, so it authenticates exactly
# the way the `claude` CLI does for the user running the service. Leave this
# unset and it uses that user's existing OAuth login — the same credentials as
# Claude Code, no separate key to manage or rotate.
#
# Setting it here overrides OAuth and bills to the key instead. Only do that if
# you specifically want the bot on separate billing, and use a dedicated key
# with a spend limit rather than your main one.
#
# ANTHROPIC_API_KEY=

# ── GitHub (optional) ─────────────────────────────────────────────────────
# Lets the agent clone and push over HTTPS.
#
# Use a FINE-GRAINED token scoped to the specific repos it should touch. This
# sits in the agent's environment, so a prompt-injected agent can use it — the
# scope is your blast radius. Create at:
#   github.com/settings/personal-access-tokens
# Permissions: Contents read/write on the repos you choose. Nothing else.
#
# HTTPS not SSH: the agent's only route out is an HTTP proxy bridge, and SSH is
# not HTTP, so git@github.com cannot leave the sandbox.
#
# GITHUB_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────
CLAWCIUS_DB_PATH=/var/lib/clawcius/clawcius.db

# ── Config location ───────────────────────────────────────────────────────
# Defaults to ./agent-config.yaml relative to the working directory.
# AGENT_CONFIG_PATH=/home/npurcell/clawcius/agent-config.yaml

# The login page: loopback port, and where `tailscale serve` publishes it.
LOGIN_PAGE_PORT=8479
LOGIN_PAGE_URL=https://vmi3493307.tail872bb7.ts.net/login

[Unit]
Description=Clawcius agent container stack (gVisor sandbox + Squid egress proxy)
Documentation=file:/home/npurcell/clawcius/SETUP.md
After=docker.service
Requires=docker.service

# clawcius.service execs into the container for every agent turn, so this must
# be up first. Without the ordering you get a bot that connects to Discord and
# then fails every turn on `docker exec`, which reads as a Discord problem.
Before=clawcius.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=npurcell
Group=npurcell
SupplementaryGroups=docker
WorkingDirectory=/home/npurcell/clawcius

# Idempotent: recreates the networks and both containers from scratch, so a
# half-torn-down state after an unclean shutdown still comes up clean.
ExecStart=/home/npurcell/clawcius/docker/up.sh
ExecStop=/home/npurcell/clawcius/docker/down.sh

# Bringing up two containers under gVisor is not instant.
TimeoutStartSec=180

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius-container

[Install]
WantedBy=multi-user.target

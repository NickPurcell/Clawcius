[Unit]
Description=Clawcius agent container stack (gVisor sandbox + Squid egress proxy)
Documentation=file:/home/npurcell/clawcius/SETUP.md
After=docker.service
Requires=docker.service

# clawcius.service execs into this container on every agent turn.
Before=clawcius.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=npurcell
Group=npurcell
SupplementaryGroups=docker
WorkingDirectory=/home/npurcell/clawcius

# Idempotent: up.sh creates what is missing, recreates Squid and reuses the agent container.
ExecStart=/home/npurcell/clawcius/docker/up.sh
ExecStop=/home/npurcell/clawcius/docker/down.sh

# Two containers under gVisor take a while to come up.
TimeoutStartSec=180

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius-container

[Install]
WantedBy=multi-user.target

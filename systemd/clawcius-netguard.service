[Unit]
Description=Clawcius sandbox network guard (host + inter-sandbox isolation)
Documentation=file:/home/npurcell/clawcius/SETUP.md

# The DOCKER-USER chain exists only once the daemon has created it, and the
# rules must be in place before any container can send a packet.
After=docker.service
Requires=docker.service
Before=clawcius-container.service hamachi-container.service

[Service]
Type=oneshot
RemainAfterExit=yes

# iptables: these rules protect the host from the sandboxes, so the sandboxes'
# own user must not be able to edit them.
User=root

ExecStart=/home/npurcell/clawcius/docker/netguard.sh

# No ExecStop: stopping this unit must not tear the rules down.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius-netguard

[Install]
WantedBy=multi-user.target

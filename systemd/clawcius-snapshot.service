[Unit]
Description=Snapshot the Clawcius agent container
After=clawcius-container.service
Requires=docker.service

[Service]
Type=oneshot
User=npurcell
Group=npurcell
SupplementaryGroups=docker
ExecStart=/srv/clawcius/current/docker/snapshot.sh

# Type=oneshot has no start timeout by default, so a wedged `docker commit`
# would leave a start job that never completes and never fails.
TimeoutStartSec=1800

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius-snapshot

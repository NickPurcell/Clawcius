[Unit]
Description=Hamachi — the operator's crew, running on the host
Documentation=file:/srv/clawcius/current/SETUP.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify
# READY=1 is sent by systemd-notify from a child process.
NotifyAccess=all
# Hamachi is the operator's hands: its own account, sudo without a password (deploy/hamachi.sudoers).
User=hamachi
Group=hamachi
WorkingDirectory=/srv/clawcius/current
EnvironmentFile=/etc/clawcius/hamachi.env
Environment=AGENT_CONFIG_PATH=/srv/clawcius/current/agent-config.hamachi.yaml
# The crew's Claude login; sessions inherit the waker's environment.
Environment=CLAUDE_CONFIG_DIR=/var/lib/hamachi/agent-home
# systemd's default PATH excludes the node install; the SDK spawns a bare `node`.
Environment=PATH=/home/npurcell/.local/share/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/npurcell/.local/share/node/bin/node dist/index.js
Restart=always
RestartSec=5
# The waker pings only while the Discord gateway is healthy.
WatchdogSec=90
# /var/lib/hamachi: the DB, workspaces and Claude login for this crew.
StateDirectory=hamachi
StateDirectoryMode=0750
# The agent sessions run in this cgroup now, not in a container.
MemoryHigh=6G
MemoryMax=8G
TasksMax=2048
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hamachi

[Install]
WantedBy=multi-user.target

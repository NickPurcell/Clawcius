[Unit]
Description=Clawcius — wakes a sandboxed Claude Code agent on Discord mentions
Documentation=file:/srv/clawcius/current/SETUP.md
After=network-online.target docker.service
Wants=network-online.target
# Every agent turn is a `docker exec`; without the daemon there is no agent.
Requires=docker.service

# Never give up on a crash loop. [Unit] directives: in [Service] systemd
# ignores them and keeps the default of 5 starts per 10s.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify
# READY=1 is sent once the Discord gateway is connected. `all`, not `main`:
# the bot shells out to systemd-notify, which sends from its own PID.
NotifyAccess=all

# npurcell owns the checkout and the state directory and is in the docker group.
User=npurcell
Group=npurcell

WorkingDirectory=/srv/clawcius/current
EnvironmentFile=/etc/clawcius/clawcius.env

# The login page: loopback only, published on the tailnet by `tailscale serve`.
Environment=LOGIN_PAGE_PORT=8479
Environment=LOGIN_PAGE_URL=https://vmi3493307.tail872bb7.ts.net/login

ExecStart=/usr/bin/node dist/index.js

Restart=always
RestartSec=5

# The bot pings only while the Discord gateway is healthy, so this catches
# process-alive-but-gateway-dead, which Restart=always cannot.
WatchdogSec=90

# /var/lib/clawcius: the DB and the per-channel workspaces.
StateDirectory=clawcius
StateDirectoryMode=0750

# These bound the waker; the container's --memory and --pids-limit bound the
# agent. Each live session holds a `docker exec` client here, so TasksMax
# scales with sessions.maxConcurrent.
MemoryHigh=3G
MemoryMax=4G
TasksMax=512

# Moderate on purpose: the waker reaches the agent over /run/docker.sock, and
# connecting to a unix socket needs write access on the inode, which
# ProtectSystem=strict's read-only /run denies.
NoNewPrivileges=true
RestrictSUIDSGID=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius

[Install]
WantedBy=multi-user.target

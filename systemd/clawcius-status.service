[Unit]
Description=Clawcius status page — read-only agent observability, loopback only
Documentation=file:/home/npurcell/clawcius/status/README.md
After=network-online.target
Wants=network-online.target

# Deliberately NOT After=docker.service or Requires= anything.
#
# The whole value of this unit is that it keeps working when the thing it is
# watching does not. It reads transcripts off local disk; it never talks to the
# agent containers, the Docker daemon, or Discord. A status page that goes down
# with the stack it monitors is a status page you cannot use at the one moment
# you need it.
#
# It does not depend on tailscaled either. `tailscale serve` is a separate,
# host-level configuration that proxies INTO this service; if tailscaled is
# down the page is simply unreachable, which is the intended failure mode.

# Same reasoning as the bot unit: never give up on a crash loop. [Unit]
# directives, not [Service] — systemd ignores them there with a warning and
# leaves the default of 5 starts per 10s.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple

# Runs as npurcell for one reason: file permissions. Each instance's
# agent-home is created by that instance's StateDirectory (mode 0750, owned by
# npurcell), so npurcell can read the transcripts and a fresh service account
# could not. This service needs no credentials of any kind — unlike the bot, it
# does not authenticate to Anthropic, Discord or GitHub — so if you ever do
# tighten the directory permissions, a dedicated read-only user with a
# supplementary group is a straightforward change here.
User=npurcell
Group=npurcell

WorkingDirectory=/home/npurcell/clawcius/status

# No EnvironmentFile. There are no secrets in this service and adding one here
# would be the first step towards there being some.
Environment=STATUS_CONFIG_PATH=/home/npurcell/clawcius/status/status-config.yaml

# Absolute path to node for the same reason the bot unit needs one: systemd
# hands services a minimal PATH that excludes ~/.local, so a bare `node` here
# dies with ENOENT at boot and works fine when you test it from a login shell.
ExecStart=/home/npurcell/.local/share/node/bin/node dist/index.js

Restart=always
RestartSec=5

# ── Resource limits ───────────────────────────────────────────────────────
# Measured, not guessed. On 2026-08-09, after indexing every session and all 14
# subagent transcripts of the largest session on this host (~4.5 MB of JSONL in
# total), RSS settled at 150 MB. Most of that is V8 heap that has not been
# collected rather than retained index — the indexes themselves are tens of
# kilobytes, since they hold offsets and per-line metadata and never message
# bodies — but the ceiling has to cover what the process actually occupies, not
# what it logically needs.
#
# So: 256M throttles, 512M is the hard stop. The first draft of this file said
# 192M/384M, written before the measurement, and 192M would have sat under the
# observed steady state — a throttle that engages during normal operation is
# worse than no throttle, because it turns a working page into a slow one for
# no reason.
#
# If this ever climbs materially above 150 MB in steady state, the cache
# discipline in transcripts.ts has regressed. Look there before raising this.
MemoryHigh=256M
MemoryMax=512M
TasksMax=32

# ── Hardening ─────────────────────────────────────────────────────────────
# Much stricter than the bot unit, and it can afford to be: this process reads
# files and writes a socket. It runs no containers, spawns no children, and has
# no bwrap or gVisor nesting to accommodate — the constraints documented in
# clawcius.service simply do not apply here.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true

# NOT MemoryDenyWriteExecute. It belongs in a list like this one and it was in
# it, until the unit was loaded for the first time on 2026-08-10 and the
# service core-dumped on SIGTRAP in a restart loop — while a stale manual `node
# dist/index.js` from the day before still held :8477, so `curl /healthz`
# answered cheerfully and the crash looked like it was not happening.
#
# V8 compiles JavaScript at runtime and needs pages that are writable and then
# executable. MemoryDenyWriteExecute forbids exactly that transition, so Node
# cannot start under it at all — this is not tunable, it is what a JIT is.
# The same applies to any JIT runtime, so do not add it to the waker units
# either; they have never carried it, which is why they run.
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectHome=read-only, not true: the working directory and the config live
# under /home/npurcell. `true` makes /home an empty tmpfs and the unit fails to
# start with a WorkingDirectory error that does not obviously say why.
ProtectHome=read-only

# ProtectSystem=strict makes the whole filesystem read-only, which suits a
# service that never writes. The transcript roots still have to be readable, and
# under strict they are — read access is unaffected — but naming them here is
# what documents the actual data dependency of this unit.
#
# ADD A LINE HERE when you add an agent instance to status-config.yaml.
ReadOnlyPaths=/var/lib/clawcius/agent-home
ReadOnlyPaths=/var/lib/hamachi/agent-home
ReadOnlyPaths=-/var/lib/oj

# The Clawsky boards — each instance's CLAWCIUS_DB_PATH. This is where the
# AGENTS are; without them the page can only list the directories under the
# transcript roots, which is the bug in Clawcius #14. Opened readOnly, which
# SQLite enforces; the waker owns these files and is writing to them live.
ReadOnlyPaths=/var/lib/clawcius/clawcius.db
ReadOnlyPaths=/var/lib/hamachi/hamachi.db

# ── The boards are in WAL, and that interacts with the line above ─────────
#
# A reader of a WAL database needs the `-shm` wal-index. If one exists it can
# be mapped read-only; if it does NOT, SQLite has to create it, which needs
# write access to the directory — and under ProtectSystem=strict this service
# has write access to nothing.
#
# While the waker is up the `-shm` exists and the registry reads fine. On a
# clean `systemctl stop` of the waker SQLite deletes `-wal` and `-shm`, and the
# registry then becomes unreadable until the waker is back. Measured on
# 2026-08-16, not inferred.
#
# That state is reported on the page, naming the waker. It is NOT worked around
# here, and specifically there is no ReadWritePaths= line: the whole claim of
# this unit is that it writes nothing, and a writable path to the board would
# put a second writer next to the one that owns it. If this is ever worth
# fixing, a dedicated read-only account with a supplementary group, or taking
# the board out of WAL, are the two changes that do not make this service a
# writer — and both belong to the operator, not to this file.
#
# Note that the transcript views are unaffected either way. They are read off
# disk and never go through SQLite.

# ── Network ───────────────────────────────────────────────────────────────
# This service accepts connections on loopback and makes none of its own. The
# address filter enforces that at the kernel level, which is a second,
# independent guarantee alongside the loopback bind in the code: even a
# compromised process here cannot reach the internet or the LAN.
#
# `localhost` covers 127.0.0.0/8 and ::1. Nothing else is permitted — note that
# this also means the service cannot reach the tailnet itself, which is correct:
# traffic flows the other way, from `tailscale serve` into this socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius-status

[Install]
WantedBy=multi-user.target

[Unit]
Description=Clawcius status page — read-only agent observability, loopback only
Documentation=file:/srv/clawcius/current/status/README.md
After=network-online.target
Wants=network-online.target

# Not ordered after docker or the agent units: this page reads transcripts off
# local disk and has to keep working when the stack it watches is down.

# Never give up on a crash loop. [Unit] directives: in [Service] systemd
# ignores them and keeps the default of 5 starts per 10s.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple

# npurcell owns each instance's agent-home (StateDirectory, mode 0750), so it
# is the user that can read the transcripts. No credentials are involved.
User=npurcell
Group=npurcell

WorkingDirectory=/srv/clawcius/current/status

# No EnvironmentFile: this service holds no secrets.
Environment=STATUS_CONFIG_PATH=/srv/clawcius/current/status/status-config.yaml

ExecStart=/usr/bin/node dist/index.js

Restart=always
RestartSec=5

# Steady-state RSS is about 150 MB, mostly uncollected V8 heap; a throttle
# below that would engage during normal operation. If it climbs, the cache
# discipline in transcripts.ts has regressed.
MemoryHigh=256M
MemoryMax=512M
TasksMax=32

# Strict: this process reads files and runs the docker CLI for the snapshot age.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true

# No MemoryDenyWriteExecute: V8 needs writable-then-executable pages, and Node
# cannot start under it.
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# read-only, not true: the working directory and the config are under /home.
ProtectHome=read-only

# The paths this unit reads, per crew in status-config.yaml: the transcript
# root, the workspaces (for bots' health.json) and the board. `-` prefixed
# where a different service creates the path, because without the dash a
# missing path fails namespace setup and the unit retries forever.
ReadOnlyPaths=/var/lib/clawcius/agent-home
ReadOnlyPaths=/var/lib/hamachi/agent-home
ReadOnlyPaths=-/var/lib/clawcius/workspaces
ReadOnlyPaths=-/var/lib/hamachi/workspaces
ReadOnlyPaths=-/var/lib/clawcius/clawcius.db
ReadOnlyPaths=-/var/lib/hamachi/hamachi.db

# No ReadWritePaths= for a board: a WAL reader needs the `-shm` beside the
# board and cannot create it under ProtectSystem=strict, so a board with no
# writer open is unreadable while that is so. The page reports that state;
# a writable path here would make this service a second writer.

# Accepts loopback connections and makes none of its own; `localhost` covers
# 127.0.0.0/8 and ::1. AF_UNIX is for the docker CLI's socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius-status

[Install]
WantedBy=multi-user.target

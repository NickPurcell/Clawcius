[Unit]
Description=Clawcius ops executor — privileged host operations requested by the sandboxed agents
Documentation=file:/home/npurcell/clawcius/ops/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# NOT ordered Before= or After= the wakers, and NOT bound to them.
#
# Restarting clawcius.service is one of the operations this unit performs. A
# dependency in either direction would mean the executor is stopped or
# restarted as a side effect of the thing it is supposed to be restarting —
# which is the exact failure the separate daemon exists to avoid. It has to
# outlive the units it acts on.

# Never give up. [Unit] directives, not [Service]: in [Service] systemd ignores
# them with a warning and leaves the default of 5 starts per 10s, after which
# the unit stays dead. This one holds rollback deadlines; it staying dead is
# how a broken rebuild becomes a permanent outage.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple

# Root, and this is the whole point of the design rather than laziness.
#
# The executor runs systemctl and docker. The agents cannot: they are in gVisor
# containers with no docker socket and no host socket, deliberately, and
# docker/run-container.sh carries the note about why mounting one would make
# gVisor decorative. This unit is the narrow, enumerated hole through that
# wall — narrow because ops-config.yaml lists every unit, repo and instance it
# may touch by exact name, and because ops/src/request.ts validates every byte
# of a request before any of it is believed.
#
# What it does NOT have: DISCORD_TOKEN, GITHUB_TOKEN, any Anthropic
# credential, or an EnvironmentFile of any kind. It talks to no network service
# and authenticates to nothing.
User=root
Group=root

WorkingDirectory=/home/npurcell/clawcius/ops

Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=OPS_CONFIG_PATH=/home/npurcell/clawcius/ops/ops-config.yaml

ExecStart=/home/npurcell/.local/share/node/bin/node dist/index.js

Restart=always
RestartSec=5

# ── State ─────────────────────────────────────────────────────────────────
# The journal, the circuit breaker and any armed rollback deadline. 0750 and
# root-owned: this is the one directory in the system that the agents must not
# be able to reach, and no part of it is bind-mounted into any container.
StateDirectory=clawcius-ops
StateDirectoryMode=0750

# ── The spools are NOT named here, and that was checked ───────────────────
#
# On 2026-08-10 the ops spool became one directory per instance
# (/var/lib/clawcius/run/ops and /var/lib/hamachi/run/ops rather than the
# single shared one), which is the kind of change that quietly needs a unit
# edit. This file was re-read line by line looking for anywhere the old path
# was named or implied. There is nowhere:
#
#   - no ReadWritePaths, so no list to extend;
#   - no ProtectSystem (=strict breaks the docker socket; see below), so the
#     filesystem is not read-only to begin with;
#   - no ProtectHome (it was removed after it made `pull` impossible), so no
#     second exception to keep in step;
#   - StateDirectory= names clawcius-ops, which is the executor's own state and
#     has nothing to do with the spools.
#
# So this unit needs no change, and the reason is written down rather than
# assumed — two units in this repository shipped with hardening that made them
# unable to run at all (MemoryDenyWriteExecute in #7, ProtectHome here), both
# times because a directive was reasoned about and never loaded.
#
# IF ANYONE ADDS ReadWritePaths= LATER: it must list every instance's
# opsSpoolDir, not just the first. The executor creates and chowns each spool
# at startup, and under a path allowlist that misses one, the failure is an
# agent whose requests are never seen — which looks exactly like an agent that
# is not filing any.

# ── Hardening ─────────────────────────────────────────────────────────────
# Deliberately light, and the reason is worth writing down rather than
# rediscovering. This unit exists to run systemctl and docker; the usual
# sandboxing directives are aimed at services that should not be able to do
# either. ProtectSystem=strict breaks the docker socket connection (writing to
# a unix socket inode needs write permission on it, which a read-only /run
# denies) — the same thing that constrains clawcius.service, for the same
# reason. PrivateDevices and ProtectKernelTunables interfere with docker's own
# operation.
#
# Anything added here must be verified with an actual restart and a real
# dry-run request, not by reading. A broken executor looks exactly like an
# agent whose requests are being ignored. That sentence was already in this
# file on 2026-08-09 and it was still not enough; see the ProtectHome block
# below for what shipped anyway.

# NOT MemoryDenyWriteExecute — audited 2026-08-10, after it turned out to be
# fatal in clawcius-status.service (#7). It was never in this unit, and it must
# never be added: V8 compiles JavaScript at runtime and needs pages mapped
# writable and then executable, which is precisely the transition the option
# forbids, so Node cannot start under it at all. This is not tunable and not
# specific to any one service — it is what a JIT is. The same audit is the
# reason for the rest of this block.

# NoNewPrivileges — false, and the interaction is worth being exact about,
# because it reads like it ought to be the thing blocking the build's privilege
# drop and it is not.
#
# NNP forbids *gaining* privilege at execve. It makes the setuid bit a no-op,
# which is why `sudo -u npurcell npm ci` and `su npurcell -c …` both fail under
# it even when the caller is already root. Dropping privilege is the opposite
# operation: a root process calling setgid(2)/setuid(2) before execve is
# unaffected by NNP, and that is how ops/src/build.ts drops to the checkout's
# owner — libuv performs the two calls in the forked child from the uid/gid
# spawn options. No sudo, no su, no setuid binary, so the build would work with
# NNP=true.
#
# It stays false for the other reason it was false: docker/run-container.sh
# runs `docker run` with --cap-drop sets and a gVisor runtime, and this unit's
# children include systemctl talking to the system bus. Neither has been tested
# under NNP on this host, and the lesson of #7 is that hardening nobody has
# loaded is hardening that has never been tested. Flipping it is a one-line
# change to make deliberately, with a restart and a real dry-run request after
# it — not a tidy-up.
NoNewPrivileges=false

# Restricts *creating* files with the setuid/setgid bit, via seccomp on chmod
# and friends. It does not touch setuid(2) itself, so the build's privilege
# drop is unaffected. npm extracts tarballs and none of this project's
# dependencies ship a setuid file; if one ever did, extraction would fail
# loudly, which is the correct outcome for a root daemon unpacking one.
RestrictSUIDSGID=true

# A no-op on this unit, kept because it costs nothing and stops being a no-op
# the day someone changes User=. systemd documents RemoveIPC as having no
# effect on objects owned by root.
RemoveIPC=true

# ── NOT ProtectHome. This one was fatal, and it shipped. ──────────────────
#
# This unit carried ProtectHome=read-only. It reads like obvious hygiene: a
# root daemon has no business writing to anybody's home directory. On this host
# it makes two of the seven verbs impossible, and it does so silently enough
# that the cause is not obvious from the failure.
#
# The checkout is /home/npurcell/clawcius. `git pull` writes .git/; `npm ci`
# writes node_modules/; `npm run build` writes dist/. Under ProtectHome all
# three get EROFS on a filesystem that is demonstrably read-write when you look
# at it from a shell, so the journal fills with permission errors against paths
# whose `ls -l` says they are fine. The `pull` verb could never have worked as
# shipped, and it would have been diagnosed as a git problem.
#
# Note also the near miss: ExecStart is /home/npurcell/.local/share/node/bin/node.
# ProtectHome=yes or =tmpfs would have hidden the interpreter and the unit would
# not have started at all — which, perversely, would have been the better
# failure, because it would have been noticed on the first restart instead of
# on the first pull.
#
# The honest accounting is that ProtectHome bought approximately nothing here.
# This unit holds the docker socket. Anything it wanted to do to a home
# directory it can still do with `docker run -v /home:/host`, one command away,
# with no namespace in the path. Paying for a boundary that a process can step
# around in a single argument, with the two verbs that actually maintain the
# deployment, is not a trade worth making.
#
# ReadWritePaths=/home/npurcell/clawcius on top of ProtectHome=read-only is the
# tidier-looking fix and it is a real one. It is not what is here, because it
# has never been loaded on this host, and shipping reasoned-but-unloaded
# hardening into this exact file is what #7 was. If someone wants it, it goes
# in with a restart, a real `pull` in dry-run, and a real one out of it.

# ── Considered and deliberately absent ────────────────────────────────────
#
# SystemCallFilter — no. The children of this unit are docker, systemctl, git,
# npm and node, plus bash for run-container.sh and snapshot.sh. @system-service
# would cover the interesting ones (the build's setgid/setuid live in @setuid,
# which @system-service includes), but "would cover" is exactly the phrase that
# preceded the SIGTRAP restart loop in #7. A filter that is one syscall short
# on this unit does not degrade: it kills a redeploy halfway through, with the
# container already destroyed.
#
# IPAddressDeny — no, and this is not close. `git pull` reaches github.com and
# `npm ci` reaches the npm registry; IPAddressDeny=any would break both and
# would break them as timeouts rather than as refusals. clawcius-status.service
# can carry it because it genuinely talks to nothing; this unit is the one that
# fetches the code.
#
# PrivateTmp — no. npm stages package tarballs through TMPDIR, and while a
# private /tmp would technically serve, it also hides the unit's /tmp from
# every other process on the host, including the operator running `ls` during
# an incident. This unit is debugged by hand at 3am by definition.
#
# ProtectSystem — see the paragraph at the top: strict breaks the docker socket.
# =full is very likely fine and is likewise untested here.

# Bounded so a runaway operation cannot take the host with it.
#
# Raised from 512M/128 on 2026-08-10. The old numbers were sized for "this
# process parses small JSON files and waits on child processes", which stopped
# being true when the build became a step: `npm ci` on this repository plus
# `tsc` over three packages runs well past 512M, and systemd's MemoryMax
# applies to the unit's whole cgroup, children included. The build would have
# been OOM-killed by the cgroup rather than failing on its own terms — a build
# failure with no compiler error in it, which is a bad half-hour.
#
# The container a redeploy starts does NOT count against these: docker places
# it in its own cgroup slice with its own --memory, so what is bounded here is
# node, npm, git and the docker/systemctl clients.
MemoryMax=2G
TasksMax=512

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clawcius-ops

[Install]
WantedBy=multi-user.target

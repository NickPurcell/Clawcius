#!/usr/bin/env python3
"""Run the CLI straight from a checkout, with no install step.

`pip install -e .` gives you the same `discord` command on PATH, but this shim
means the tool works on any machine with python3 and nothing else -- which is
the point of keeping the implementation to the standard library.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dcli.cli import entrypoint  # noqa: E402

if __name__ == "__main__":
    entrypoint()

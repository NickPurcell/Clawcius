#!/usr/bin/env node
/* Run the tool straight from the mount, with no install step: the directory
 * is bind-mounted read-only into every agent container. */
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';

// Call `main()` explicitly: launched through this shim, `process.argv[1]` is
// this file, so the module's self-run guard does not fire.
const { main } = await import(join(dirname(fileURLToPath(import.meta.url)), 'pr-state.mjs'));
main();

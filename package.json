{
  "name": "clawcius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot bridging an Agent SDK agent to sandboxed Claude Code instances",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-info.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-info.mjs && node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "node scripts/build-info.mjs && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'test/*.test.js'",
    "check-docs": "node scripts/check-orphaned-docs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "discord.js": "^14.16.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}

#!/usr/bin/env python3
"""
gdoc — read and edit Google Docs from the command line.

No third-party dependencies, deliberately. This mirrors discord-cli: the tool
is bind-mounted read-only into the agent container and must work the moment it
lands, with no install step. An earlier version leaned on google-auth inside a
virtualenv in the container's home directory, which a VPS migration deleted
along with everything else there. Stdlib-only survives that.

That constraint means signing the service-account JWT by hand — RSA PKCS#1
v1.5, which Python's big integers do natively. See rsa_sign_sha256 below.

It also sidesteps a trap: google-api-python-client's httplib2 transport ignores
http_proxy/https_proxy, and the agent container has no direct route out, DNS
included. The symptom is "unable to find the server at oauth2.googleapis.com"
on a host where curl works. urllib reads the proxy environment by default, so
this simply works.

Authenticates as a *service account*, not as a person: there is no browser here
to complete an OAuth consent screen. The account is its own Google identity
with an empty Drive and sees nothing until a document is shared with its
address, exactly like sharing with a colleague. `gdoc whoami` prints it.

Credentials are looked for at, in order:
  $GWS_SA_KEY
  ~/.config/gws/service-account.json
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

DEFAULT_KEY = Path.home() / ".config" / "gws" / "service-account.json"
SCOPES = (
    "https://www.googleapis.com/auth/documents "
    "https://www.googleapis.com/auth/drive"
)
DOCS_API = "https://docs.googleapis.com/v1/documents"
DRIVE_API = "https://www.googleapis.com/drive/v3/files"
TOKEN_URI = "https://oauth2.googleapis.com/token"


def die(msg: str, code: int = 1) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def key_path() -> Path:
    env = os.environ.get("GWS_SA_KEY")
    return Path(env) if env else DEFAULT_KEY


def load_key() -> dict:
    path = key_path()
    if not path.exists():
        die(
            f"no service account key at {path}\n"
            "hint:  place the JSON key there, or set GWS_SA_KEY to its path.\n"
            "       `gdoc setup` explains how to create one."
        )
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        die(f"could not parse {path}: {exc}")
    for field in ("client_email", "private_key"):
        if field not in data:
            die(f"{path} is missing '{field}' — is it a service account JSON key?")
    return data


# ── minimal DER + RSA, so the tool needs nothing installed ────────────────


def der_read(buf: bytes, offset: int) -> tuple[int, bytes, int]:
    """Read one DER TLV at `offset`. Returns (tag, value, next_offset)."""
    tag = buf[offset]
    length = buf[offset + 1]
    offset += 2
    if length & 0x80:
        count = length & 0x7F
        length = int.from_bytes(buf[offset : offset + count], "big")
        offset += count
    return tag, buf[offset : offset + length], offset + length


def der_ints(sequence: bytes) -> list[int]:
    """Every INTEGER in a DER SEQUENCE's contents, in order."""
    out, offset = [], 0
    while offset < len(sequence):
        tag, value, offset = der_read(sequence, offset)
        if tag == 0x02:
            out.append(int.from_bytes(value, "big"))
    return out


def rsa_private_params(pem: str) -> tuple[int, int]:
    """
    Pull (modulus, private exponent) out of a PKCS#8 or PKCS#1 RSA PEM.

    Google issues PKCS#8 ("BEGIN PRIVATE KEY"), which wraps the PKCS#1
    RSAPrivateKey in an OCTET STRING. PKCS#1 ("BEGIN RSA PRIVATE KEY") is
    accepted too, since keys converted by hand are common enough.
    """
    body = "".join(
        line for line in pem.strip().splitlines() if not line.startswith("-----")
    )
    try:
        der = base64.b64decode(body)
    except Exception as exc:  # noqa: BLE001
        die(f"private_key is not valid base64: {exc}")

    _, outer, _ = der_read(der, 0)

    # PKCS#1: the first SEQUENCE already holds the nine RSA integers.
    ints = der_ints(outer)
    if len(ints) >= 9:
        return ints[1], ints[3]

    # PKCS#8: find the OCTET STRING and parse the RSAPrivateKey inside it.
    offset = 0
    while offset < len(outer):
        tag, value, offset = der_read(outer, offset)
        if tag == 0x04:
            _, inner, _ = der_read(value, 0)
            ints = der_ints(inner)
            if len(ints) >= 9:
                return ints[1], ints[3]
    die("could not parse RSA private key from the service account JSON")


# DigestInfo DER prefix for SHA-256, per RFC 8017 §9.2.
SHA256_DIGEST_INFO = bytes.fromhex("3031300d060960864801650304020105000420")


def rsa_sign_sha256(message: bytes, modulus: int, exponent: int) -> bytes:
    """
    RSASSA-PKCS1-v1_5 signature over SHA-256.

    Deterministic, which is what makes it testable: the same input must produce
    the byte-identical signature any other correct implementation produces.
    """
    size = (modulus.bit_length() + 7) // 8
    tail = SHA256_DIGEST_INFO + hashlib.sha256(message).digest()
    if size < len(tail) + 11:
        die("RSA key is too small to sign with SHA-256")
    padded = b"\x00\x01" + b"\xff" * (size - len(tail) - 3) + b"\x00" + tail
    signed = pow(int.from_bytes(padded, "big"), exponent, modulus)
    return signed.to_bytes(size, "big")


def b64url(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def access_token() -> str:
    """Mint a short-lived access token via the JWT bearer grant."""
    key = load_key()
    modulus, exponent = rsa_private_params(key["private_key"])
    now = int(time.time())
    header = {"alg": "RS256", "typ": "JWT", "kid": key.get("private_key_id", "")}
    claims = {
        "iss": key["client_email"],
        "scope": SCOPES,
        "aud": key.get("token_uri", TOKEN_URI),
        "iat": now,
        "exp": now + 3600,
    }
    signing_input = (
        b64url(json.dumps(header).encode()) + "." + b64url(json.dumps(claims).encode())
    )
    signature = rsa_sign_sha256(
        signing_input.encode(), modulus, exponent
    )
    assertion = f"{signing_input}.{b64url(signature)}"

    body = urllib.parse.urlencode(
        {
            "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
            "assertion": assertion,
        }
    ).encode()
    request = urllib.request.Request(
        key.get("token_uri", TOKEN_URI),
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)["access_token"]
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf8", "replace")
        try:
            parsed = json.loads(detail)
            detail = parsed.get("error_description") or parsed.get("error") or detail
        except json.JSONDecodeError:
            pass
        die(
            f"Google rejected the service account credentials: {detail}\n"
            f"hint:  check the key at {key_path()} is current, that the service "
            "account still exists, and that the Docs and Drive APIs are enabled."
        )
    except urllib.error.URLError as exc:
        die(f"could not reach {TOKEN_URI}: {exc.reason}")


def api_call(method: str, url: str, params: dict | None = None, body: dict | None = None):
    """Make an authorized request, turning Google's errors into readable ones."""
    if params:
        url = f"{url}?{urllib.parse.urlencode(params)}"
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {access_token()}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = response.read()
            return json.loads(payload) if payload else {}
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            die(
                "document not found, or not shared with this service account.\n"
                "hint:  run `gdoc whoami` and share the doc with that address "
                "as an Editor."
            )
        if exc.code == 403:
            die(
                "permission denied. The document exists but this service account "
                "cannot reach it.\n"
                "hint:  share it as an Editor, and confirm the Docs and Drive "
                "APIs are enabled in the Cloud project."
            )
        detail = exc.read().decode("utf8", "replace")
        try:
            detail = json.loads(detail).get("error", {}).get("message", detail)
        except json.JSONDecodeError:
            detail = detail[:300]
        die(f"Google API error {exc.code}: {detail}")
    except urllib.error.URLError as exc:
        die(f"could not reach Google: {exc.reason}")


# ── documents ─────────────────────────────────────────────────────────────

DOC_ID_RE = re.compile(r"/document/d/([a-zA-Z0-9_-]+)")


def resolve_id(ref: str) -> str:
    """Accept a full Docs URL or a bare document ID."""
    match = DOC_ID_RE.search(ref)
    if match:
        return match.group(1)
    if "/" in ref or " " in ref:
        die(f"could not find a document ID in: {ref}")
    return ref


def doc_text(document: dict) -> str:
    """Flatten a Docs document body to plain text."""
    out: list[str] = []
    for element in document.get("body", {}).get("content", []):
        for run in element.get("paragraph", {}).get("elements", []):
            text = run.get("textRun", {}).get("content")
            if text:
                out.append(text)
    return "".join(out)


def end_index(document: dict) -> int:
    """
    The last insertable position.

    The body's final segment is a newline the API owns and will not let you
    write after, so appending targets one before the reported end.
    """
    content = document.get("body", {}).get("content", [])
    if not content:
        return 1
    return max(1, content[-1].get("endIndex", 2) - 1)


def get_document(doc_id: str) -> dict:
    return api_call("GET", f"{DOCS_API}/{doc_id}")


def batch_update(doc_id: str, requests: list[dict]) -> dict:
    return api_call(
        "POST", f"{DOCS_API}/{doc_id}:batchUpdate", body={"requests": requests}
    )


# ── commands ──────────────────────────────────────────────────────────────


def cmd_whoami(args: argparse.Namespace) -> None:
    key = load_key()
    print(f"service account : {key['client_email']}")
    print(f"project         : {key.get('project_id', '(unknown)')}")
    print(f"key file        : {key_path()}")
    print()
    print("Share any doc you want edited with the address above, as Editor.")


def cmd_read(args: argparse.Namespace) -> None:
    document = get_document(resolve_id(args.doc))
    if args.title_only:
        print(document.get("title", ""))
        return
    sys.stdout.write(doc_text(document))


def cmd_append(args: argparse.Namespace) -> None:
    text = args.text if args.text is not None else sys.stdin.read()
    if not text:
        die("nothing to append")
    doc_id = resolve_id(args.doc)
    document = get_document(doc_id)
    batch_update(
        doc_id,
        [{"insertText": {"location": {"index": end_index(document)}, "text": text}}],
    )
    print(f"appended {len(text)} chars to {document.get('title', doc_id)}")


def cmd_replace(args: argparse.Namespace) -> None:
    result = batch_update(
        resolve_id(args.doc),
        [
            {
                "replaceAllText": {
                    "containsText": {
                        "text": args.find,
                        "matchCase": not args.ignore_case,
                    },
                    "replaceText": args.replace,
                }
            }
        ],
    )
    changed = (
        result.get("replies", [{}])[0]
        .get("replaceAllText", {})
        .get("occurrencesChanged", 0)
    )
    print(f"replaced {changed} occurrence(s)")
    if changed == 0:
        print(
            "note: nothing matched — check case, or pass --ignore-case",
            file=sys.stderr,
        )


def cmd_list(args: argparse.Namespace) -> None:
    result = api_call(
        "GET",
        DRIVE_API,
        params={
            "q": "mimeType='application/vnd.google-apps.document' and trashed=false",
            "fields": "files(id,name,modifiedTime)",
            "pageSize": args.limit,
            "orderBy": "modifiedTime desc",
        },
    )
    files = result.get("files", [])
    if not files:
        print("no documents visible to this service account.")
        print("Share a doc with the address from `gdoc whoami`, as Editor.")
        return
    for f in files:
        print(f"{f['id']}  {f['modifiedTime'][:10]}  {f['name']}")


def cmd_setup(args: argparse.Namespace) -> None:
    print(
        f"""\
Setting up gdoc — four steps, all on your side. No secret goes through chat.

1. Google Cloud console → create (or pick) a project.

2. Enable both APIs in that project:
     Google Docs API
     Google Drive API

3. Create a service account, then a JSON key for it:
     IAM & Admin → Service Accounts → Create
     → the account → Keys → Add key → Create new key → JSON
   No roles are needed. Access comes from document sharing, not IAM.

4. Put the downloaded JSON on the host, at the path below, and make sure it
   is mounted into the agent container so it survives a rebuild:
     {DEFAULT_KEY}
   Then run `gdoc whoami` and share your doc with the address it prints,
   as an Editor.

Do NOT paste the key into Discord. Step 4 exists so it never has to be.

Current key path: {key_path()}  (present: {key_path().exists()})"""
    )


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="gdoc", description="Read and edit Google Docs from the command line."
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("setup", help="How to create the service account key.").set_defaults(
        func=cmd_setup
    )
    sub.add_parser(
        "whoami", help="Show the service account address to share docs with."
    ).set_defaults(func=cmd_whoami)

    p = sub.add_parser("list", help="List docs shared with the service account.")
    p.add_argument("--limit", type=int, default=25)
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("read", help="Print a document as plain text.")
    p.add_argument("doc", help="Document URL or ID")
    p.add_argument("--title-only", action="store_true")
    p.set_defaults(func=cmd_read)

    p = sub.add_parser("append", help="Append text to the end of a document.")
    p.add_argument("doc", help="Document URL or ID")
    p.add_argument("-t", "--text", help="Text to append; omit to read stdin")
    p.set_defaults(func=cmd_append)

    p = sub.add_parser("replace", help="Replace all occurrences of a string.")
    p.add_argument("doc", help="Document URL or ID")
    p.add_argument("--find", required=True)
    p.add_argument("--replace", required=True)
    p.add_argument("--ignore-case", action="store_true")
    p.set_defaults(func=cmd_replace)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

# No trailing slash: `node_modules/` matches only a directory, and a worktree's
# node_modules is a symlink.
node_modules
dist/

# Written by scripts/build-info.mjs before every `tsc`; a tracked copy would
# leave the tree dirty after every build. One path per package, so a new
# package is a visible omission.
src/build-info.ts
status/src/build-info.ts

# Per-instance env files carry a bot token; the negation keeps the template tracked.
.env
.env.*
!.env.example

# Private keys. The repository is public, so the rule is broad on purpose.
*.pem
*.key
*.p12

*.log

# SQLite + WAL sidecars
*.db
*.db-wal
*.db-shm

# OAuth client secrets
client_secret_*.json
